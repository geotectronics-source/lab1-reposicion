# =============================================================================
# Variables del entorno de Airflow — PLANTILLA
# =============================================================================
# Cópialo a `docker/.env`, que está en `.gitignore`:
#
#     cp docker/.env.ejemplo docker/.env
#
# y genera tu propia clave Fernet con
#
#     docker run --rm apache/airflow:3.3.2-python3.12 \
#       python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Ninguno de estos valores es un secreto de verdad: es un Airflow local sin
# conexiones a sistemas externos. Van en un archivo aparte de todas formas,
# porque la alternativa —escribirlos en el compose— enseña el hábito de
# commitear credenciales, y ese hábito se arrastra al proyecto donde sí
# importan.
# =============================================================================

# Cifra las conexiones y variables guardadas en la base. Si se deja vacía,
# cada servicio genera una distinta al arrancar y lo que cifre uno no lo puede
# leer el otro.
FERNET_KEY=

# Firma los tokens con los que las tareas hablan con el servidor de ejecución.
AIRFLOW__API_AUTH__JWT_SECRET=reposicion-lab1

# Usuario de la interfaz web (http://localhost:8080).
AIRFLOW_WWW_USER=airflow
AIRFLOW_WWW_PASSWORD=airflow

# Dueño de los archivos que Airflow escriba en el repositorio. En Linux tiene
# que ser tu UID (`id -u`) o los archivos quedan como root y no los puedes
# borrar. En Windows y macOS es indiferente: Docker Desktop traduce permisos.
AIRFLOW_UID=50000

# Puerto del equipo en el que se publica la interfaz. Cámbialo si ya tienes
# algo escuchando en el 8080: otro Airflow, por ejemplo, que es más común de
# lo que parece en cuanto se tiene más de un proyecto con Docker.
AIRFLOW_PORT=8080
